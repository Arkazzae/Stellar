<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stellarr.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      Workstation GC, not the Server GC the web SDK chooses: an instance
      serves a small group, and Server GC sizes the heap for a dominant
      process on a large machine. Measured on the container, it kept the
      API about 50 MB smaller after a signed-in load with the same latency.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.12" />
    <PackageReference Include="Fido2" Version="4.3.3" />
    <PackageReference Include="MailKit" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
</Project>
