# The host ports of the throwaway stack the film is captured from, beside a
# running development stack (3000, 5000), so that both can be up at once.
# compose.film.yml sets the instance's settings.
STELLARR_DEV_WEB_PORT=3100
STELLARR_DEV_API_PORT=5100
STELLARR_DEV_MEDIA_PORT=49110
STELLARR_DEV_MEDIA_CONTROL_PORT=5210
