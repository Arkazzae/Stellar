{
  "name": "stellarr-workspace",
  "private": true,
  "workspaces": [
    "web",
    "sdk",
    "packages/*"
  ],
  "scripts": {
    "build:web": "npm run build -w stellarr-web",
    "test:web": "npm run test -w stellarr-web",
    "test:ui": "npm run test -w @stellarr/ui",
    "test:icons": "npm run test -w @stellarr/icons",
    "test:router": "npm run test -w @stellarr/router",
    "lint:web": "npm run lint -w stellarr-web",
    "typecheck:web": "npm run typecheck -w stellarr-web",
    "typecheck:ui": "npm run typecheck -w @stellarr/ui",
    "typecheck:icons": "npm run typecheck -w @stellarr/icons",
    "typecheck:router": "npm run typecheck -w @stellarr/router",
    "test:sdk": "npm test -w @stellarr/sdk"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "eslint-plugin-import": {
      "eslint": "^10.14.0"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.14.0"
    },
    "eslint-plugin-react": {
      "eslint": "^10.14.0"
    }
  }
}
