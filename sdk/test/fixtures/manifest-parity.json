{
  "base": {
    "protocol": 1,
    "id": "parity",
    "name": "Manifest parity",
    "description": "Shared manifest cases.",
    "version": "1.0.0"
  },
  "cases": [
    { "label": "omitted optional fields and lists", "fields": {}, "valid": true },
    { "label": "nullable optional fields", "fields": { "icon": null, "cover": null, "authority": null, "seats": null, "devices": null }, "valid": true },
    { "label": "empty defaultable lists", "fields": { "permissions": [], "connects": [] }, "valid": true },
    { "label": "null permissions", "fields": { "permissions": null }, "valid": false },
    { "label": "null connects", "fields": { "connects": null }, "valid": false },
    { "label": "null launch modes", "fields": { "launchModes": null }, "valid": false },
    { "label": "duplicate permissions", "fields": { "permissions": ["media.cameraTile", "media.cameraTile"] }, "valid": false },
    { "label": "distinct permissions", "fields": { "permissions": ["media.cameraTile", "media.microphoneLevel"] }, "valid": true },
    { "label": "GIF search permission", "fields": { "permissions": ["media.gifs"] }, "valid": true },
    { "label": "unknown permission", "fields": { "permissions": ["media.gifsearch"] }, "valid": false },
    { "label": "permission supplied as an object", "fields": { "permissions": [{ "toString": null }] }, "valid": false },
    { "label": "no implicit protocol", "fields": { "protocol": null }, "valid": false },
    { "label": "string seat count", "fields": { "seats": "1" }, "valid": false },
    { "label": "maximum seat count", "fields": { "seats": 128 }, "valid": true },
    { "label": "out-of-range seat count", "fields": { "seats": 129 }, "valid": false },
    { "label": "valid dotted lowercase host", "fields": { "connects": [{ "host": "media-1.example", "why": "Video playback" }] }, "valid": true },
    { "label": "uppercase host", "fields": { "connects": [{ "host": "Media.example", "why": "Video playback" }] }, "valid": false },
    { "label": "host label starts with hyphen", "fields": { "connects": [{ "host": "-media.example", "why": "Video playback" }] }, "valid": false },
    { "label": "host label ends with hyphen", "fields": { "connects": [{ "host": "media-.example", "why": "Video playback" }] }, "valid": false },
    { "label": "undotted host", "fields": { "connects": [{ "host": "localhost", "why": "Video playback" }] }, "valid": false },
    { "label": "trailing DNS separator", "fields": { "connects": [{ "host": "media.example.", "why": "Video playback" }] }, "valid": false },
    { "label": "host with leading whitespace", "fields": { "connects": [{ "host": " media.example", "why": "Video playback" }] }, "valid": false },
    { "label": "host with trailing newline", "fields": { "connects": [{ "host": "media.example\n", "why": "Video playback" }] }, "valid": false },
    { "label": "blank Unicode reason", "fields": { "connects": [{ "host": "media.example", "why": "\u0085" }] }, "valid": false },
    { "label": "blank Unicode name", "fields": { "name": "\u0085" }, "valid": false },
    { "label": "maximum SemVer core fields", "fields": { "version": "18446744073709551615.18446744073709551615.18446744073709551615" }, "valid": true },
    { "label": "overflowing SemVer major", "fields": { "version": "18446744073709551616.0.0" }, "valid": false },
    { "label": "overflowing SemVer minor", "fields": { "version": "1.18446744073709551616.0" }, "valid": false },
    { "label": "overflowing SemVer patch", "fields": { "version": "1.0.18446744073709551616" }, "valid": false },
    { "label": "large prerelease identifier and zero-prefixed build", "fields": { "version": "1.0.0-18446744073709551616+0001" }, "valid": true },
    { "label": "invalid numeric prerelease", "fields": { "version": "1.0.0-01" }, "valid": false },
    { "label": "version with trailing newline", "fields": { "version": "1.0.0\n" }, "valid": false }
  ],
  "rawCases": [
    {"label": "duplicate known manifest field", "members": "\"name\":\"Second name\"", "valid": false},
    {"label": "duplicate escaped manifest field", "members": "\"n\\u0061me\" : \"Second name\"", "valid": false},
    {"label": "duplicate nullable optional field", "members": "\"icon\":null,\"icon\":null", "valid": false},
    {"label": "duplicate launch modes field", "members": "\"launchModes\":[\"voice\"],\"launchModes\":[\"personal\"]", "valid": false},
    {"label": "duplicate connects field", "members": "\"connects\":[],\"connects\":[]", "valid": false},
    {"label": "duplicate host within connects entry", "members": "\"connects\":[{\"host\":\"one.example\",\"h\\u006fst\":\"two.example\",\"why\":\"Video\"}]", "valid": false},
    {"label": "duplicate why in escaped connects array", "members": "\"c\\u006fnnects\" : [{\"host\":\"one.example\",\"why\":\"Video\",\"wh\\u0079\" : \"Other reason\"}]", "valid": false},
    {"label": "host and why in separate connections", "members": "\"connects\":[{\"host\":\"one.example\",\"why\":\"Video\"},{\"host\":\"two.example\",\"why\":\"Video\"}]", "valid": true},
    {"label": "duplicate unknown root and extension fields", "members": "\"extension\":{\"name\":7,\"n\\u0061me\":9,\"connects\":[{\"host\":1,\"host\":2}]},\"custom\":1,\"custom\":2", "valid": true},
    {"label": "duplicate unknown fields in a connection", "members": "\"connects\":[{\"host\":\"one.example\",\"why\":\"Video\",\"name\":false,\"name\":true,\"metadata\":{\"host\":\"A\",\"host\":\"B\",\"why\":1,\"why\":2}}]", "valid": true},
    {"label": "key-shaped text in a known field", "members": "\"connects\":[{\"host\":\"one.example\",\"why\":\"An embedded JSON example: {\\\"name\\\": 1, \\\"name\\\": 2, \\\"host\\\": [\\\"videos\\\"]}\"}]", "valid": true},
    {"label": "trailing odd backslashes and escaped quotes in strings", "members": "\"connects\":[{\"host\":\"one.example\",\"why\":\"Path \\\\\\\", then \\\"host\\\" and \\\"host\\\" and \\\\\\\\\"}]", "valid": true}
  ]
}
