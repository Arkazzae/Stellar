# ---------------------------------------------------------------------------
# Local configuration and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
*.local
/.impeccable/

*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
secrets/
certs/

# Local Compose overrides may contain host paths, ports and credentials.
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

# ---------------------------------------------------------------------------
# Runtime data — the real deployment mounts this outside the repository
# ---------------------------------------------------------------------------
/data/
/uploads/
/storage/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.log
*.pid

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
**/bin/
**/obj/
**/TestResults/
**/artifacts/
/.artifacts/
# The top-level artifacts/ is not build output but the browser's binaries, their
# manifest and the recipes that build some of them.
!/artifacts/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
**/__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Node / test runners
# ---------------------------------------------------------------------------
**/node_modules/
**/.turbo/
**/dist/
**/out/
**/coverage/
**/.nyc_output/
**/playwright-report/
**/test-results/
**/blob-report/
*.tsbuildinfo
.eslintcache
.stylelintcache

# Documentation site (docs/): VitePress build output and cache.
/docs/.vitepress/dist/
/docs/.vitepress/cache/
/web/bench/results/
/web/.locales/

# Static browser files installed from the two Stellarr runtime packages.
/web/public/audio/*-worklet.js
/web/public/audio/*.wasm
/web/public/codecs/
/web/public/bergamot-models/

# Compiler outputs for npm package releases.
/artifacts/recipes/*/out/

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
/media/target/
# **/bin/ above is build output of other tools, but src/bin holds extra
# binaries of a Rust crate.
!/media/src/bin/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
# scripts/seed-dev.py leaves bytecode behind when it runs.
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Editors, operating systems and temporary files
# ---------------------------------------------------------------------------
.vs/
.idea/
.vscode/
.fleet/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.temp
.playwright-mcp/

# ---------------------------------------------------------------------------
# Local AI agent instructions and workspaces (keep out of public repository)
# ---------------------------------------------------------------------------
AGENTS.md
CLAUDE.md
.agents/
.claude/
