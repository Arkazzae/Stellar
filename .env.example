# Stellarr's settings. The container reads this file as it is: uncomment a line
# and change its value, then apply it with `docker compose up -d`. Every line
# shows the default, or an example where there is none. An empty value counts
# as not set. docs/install/configuration.md describes each setting.

# --- Release

# The image tag to run. Pin a release, such as 1.2 or 1.2.3, for a real
# installation; latest follows every new release.
# STELLARR_VERSION=latest

# --- Address and TLS

# The name or IPv4 address people open Stellarr at. Without it the instance
# uses localhost, which only this machine can reach.
# STELLARR_DOMAIN=chat.example.com

# The IPv4 address browsers reach this host at for media. When this is empty,
# the media server can use an IPv4 address entered as STELLARR_DOMAIN.
# Set this to auto to resolve the domain's A record at startup.
# STELLARR_PUBLIC_IP=203.0.113.10

# HTTPS is public. HTTP is bound to loopback for a reverse proxy on this
# host. An explicit bare HTTP port publishes it on all interfaces.
# STELLARR_HTTPS_PORT=443
# STELLARR_HTTP_PORT=127.0.0.1:8888

# The HTTPS port browsers use, when it is not STELLARR_HTTPS_PORT, as behind a
# reverse proxy.
# STELLARR_PUBLIC_PORT=443

# The full public address, in place of the one built from the domain and port.
# STELLARR_PUBLIC_URL=https://chat.example.com

# The reverse proxies in front of the container, as the container sees them,
# separated by commas. See docs/install/reverse-proxy-and-tls.md.
# STELLARR_TRUSTED_PROXIES=172.18.0.1

# --- Voice and RTC

# The host port for Stellarr Media. UDP is preferred and TCP is the fallback.
# Forward the same external port for both transports.
# STELLARR_MEDIA_PORT=49000

# Public TURN is optional. Include docker-compose.turn.yml with the base
# Compose file, or use the installer's --enable-turn option.
# STELLARR_TURN_ENABLED=false

# The optional TURN listener ports and the UDP range coturn uses for relay
# allocations. Publish this range 1:1 with the same ports on both sides.
# STELLARR_TURN_PORT=3478
# STELLARR_TURNS_PORT=5349
# STELLARR_TURN_RELAY_RANGE=49160-49200

# TURN over TCP, and TURN over TLS/DTLS, which needs a certificate browsers
# trust.
# STELLARR_TURN_TCP_ENABLED=false
# STELLARR_TURNS_ENABLED=false

# --- Uploads and quotas

# Storage per account and in total, and the free space uploads leave on the
# data volume, in bytes; 0 turns a check off.
# STELLARR_UPLOAD_USER_BYTES=2147483648
# STELLARR_UPLOAD_TOTAL_BYTES=21474836480
# STELLARR_MIN_FREE_BYTES=1073741824
# STELLARR_MAX_CONCURRENT_UPLOADS=4

# --- Mail

# The first value of Cockpit's mail switch and sender; Cockpit's wins once
# saved. The SMTP server, port and login are set in Cockpit.
# STELLARR_MAIL_ENABLED=true
# STELLARR_MAIL_FROM=stellarr@chat.example.com
# STELLARR_MAIL_FROM_NAME=Stellarr

# The SMTP password and the Resend key, when they are not set in Cockpit.
# STELLARR_SMTP_PASSWORD=
# STELLARR_RESEND_API_KEY=

# --- Web Push

# Browser notifications, off until a VAPID key pair is set. A new pair makes
# every browser subscribe again. See docs/admin/notifications.md#web-push.
# STELLARR_PUSH_ENABLED=false
# STELLARR_PUSH_SUBJECT=mailto:admin@chat.example.com
# STELLARR_PUSH_PUBLIC_KEY=
# STELLARR_PUSH_PRIVATE_KEY=

# --- Single sign-on (OIDC)

# Sign-in through an identity provider such as Pocket ID, beside passwords.
# STELLARR_OIDC_ENABLED=false
# STELLARR_OIDC_ISSUER=https://auth.example.com
# STELLARR_OIDC_CLIENT_ID=
# STELLARR_OIDC_CLIENT_SECRET=
# STELLARR_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret

# The label of the sign-in button. Without it, the instance language's own:
# Main account, or Konto główne in Polish.
# STELLARR_OIDC_DISPLAY_NAME=Pocket ID

# Whether a provider sign-in with one of these amr values counts as Stellarr's
# second step. Only for a provider that reports a real second factor.
# STELLARR_OIDC_TRUST_PROVIDER_MFA=false
# STELLARR_OIDC_PROVIDER_MFA_AMR=mfa

# --- Automatic backups and Cloudflare R2

# The first schedule of automatic full backups; Cockpit's wins once saved.
# STELLARR_BACKUP_ENABLED=true
# STELLARR_BACKUP_INTERVAL_HOURS=24
# STELLARR_BACKUP_RETRY_MINUTES=15
# STELLARR_BACKUP_INITIAL_DELAY_MINUTES=5

# Offsite copies in a private R2 bucket, s3 or worker mode, also set in
# Cockpit. See docs/admin/cloudflare-r2.md.
# STELLARR_CLOUDFLARE_R2_ENABLED=false
# STELLARR_CLOUDFLARE_R2_MODE=s3
# STELLARR_CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# STELLARR_CLOUDFLARE_R2_REGION=auto
# STELLARR_CLOUDFLARE_R2_BUCKET=stellarr-backups
# STELLARR_CLOUDFLARE_R2_ACCESS_KEY=
# STELLARR_CLOUDFLARE_R2_SECRET_KEY=
# STELLARR_CLOUDFLARE_R2_WORKER_TOKEN=
# STELLARR_CLOUDFLARE_R2_PREFIX=stellarr

# --- Language

# The language of the interface and of everything the server says: en or pl.
# STELLARR_LANGUAGE=en

# --- Instance identity and desktop handshake

# Generated and kept in the data volume when not set.
# STELLARR_INSTANCE_ID=11111111-2222-4333-8444-555555555555

# The first value of Cockpit's time zone; the container's own, UTC, without it.
# STELLARR_TIME_ZONE=Europe/Warsaw

# The oldest desktop client allowed in, and the one the handshake recommends.
# STELLARR_DESKTOP_MINIMUM_VERSION=0.1.0
# STELLARR_DESKTOP_RECOMMENDED_VERSION=0.1.3

# --- Other settings

# The public GIPHY web key for GIF search, when it is not set in Cockpit.
# STELLARR_GIPHY_API_KEY=

# --- Container resource limits

# Docker's memory limit, CPU quota and process limit for the container.
# STELLARR_CONTAINER_MEMORY_LIMIT=4g
# STELLARR_CONTAINER_CPUS=4
# STELLARR_CONTAINER_PIDS_LIMIT=512

# --- Advanced

# When the self-signed certificate is renewed, and how often that is checked,
# in seconds.
# STELLARR_TLS_RENEW_BEFORE_SECONDS=2592000
# STELLARR_TLS_RENEW_CHECK_SECONDS=43200

# The media server's host candidates as ip:port, separated by commas, in place
# of the ones derived from STELLARR_PUBLIC_IP; and its log filter.
# STELLARR_MEDIA_ADVERTISE=203.0.113.10:49000
# STELLARR_MEDIA_LOG=info
