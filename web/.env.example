# For `npm run dev` and `npm run preview` in web/, outside Docker: copy to
# web/.env. The development stack sets these itself, and production reads
# none of them.

# Where the servers proxy /api, /assets, /health, /hubs and
# /.well-known/stellarr/client: an API from `dotnet run`, by default.
# STELLARR_API_ORIGIN=http://127.0.0.1:5000

# The instance's language, which the servers answer at /stellarr-instance.js:
# en or pl. Without it, English.
# STELLARR_LANGUAGE=en

# Further host names the servers answer, comma-separated, for an IDE or a
# remote preview. localhost and IP addresses always work.
# STELLARR_DEV_ALLOWED_HOSTS=preview.example.test,devbox.example.test

# true polls for file changes, where file events do not cross a bind mount.
# Off by default.
# STELLARR_DEV_POLLING=true

# ICE servers for a development build that runs without an API's TURN, as a
# JSON array; STUN only. A production build ignores it and uses the servers
# /api/bootstrap names.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"}]
