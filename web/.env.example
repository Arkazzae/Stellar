# Optional ICE servers for the WebRTC voice transport, as a JSON array. The
# build writes it into the web client. A LAN-only self-hosted instance
# normally needs none.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"}]

# Where `npm run dev` and `npm run preview` proxy /api, /assets, /health,
# /hubs and /.well-known/stellarr/client. Production uses Nginx and ignores
# this. Defaults to http://127.0.0.1:5000.
# STELLARR_API_ORIGIN=http://127.0.0.1:5000

# The instance's default language, which the dev and preview servers answer
# at /stellarr-instance.js. In production the container writes that file.
# STELLARR_LANGUAGE=en

# Further host names the dev and preview servers answer, comma-separated, for
# an IDE or remote preview. localhost and IP addresses always work.
# STELLARR_DEV_ALLOWED_HOSTS=preview.example.test,devbox.example.test

# Poll for file changes where file events do not cross a bind mount, as with
# Docker Desktop on macOS and Windows.
# STELLARR_DEV_POLLING=true
