# Template: the entrypoint substitutes the placeholders below and writes the
# result to /etc/turnserver.conf.
listening-port=3478
tls-listening-port=5349
# Each of these lines is a comment, or no-tcp / no-tls / no-dtls when the
# matching transport is switched off (STELLARR_TURN_TCP_ENABLED,
# STELLARR_TURNS_ENABLED).
__TURN_TCP_LINE__
__TURN_TLS_LINE__
__TURN_DTLS_LINE__
listening-ip=0.0.0.0
relay-ip=0.0.0.0
# Compose publishes the UDP allocations one-to-one.
min-port=__TURN_RELAY_MIN__
max-port=__TURN_RELAY_MAX__
fingerprint

# The API hands out time-limited credentials derived from this shared secret.
use-auth-secret
static-auth-secret=__STATIC_AUTH_SECRET__
realm=__REALM__
# external-ip=<STELLARR_PUBLIC_IP>, or a comment while it is empty.
__EXTERNAL_IP_LINE__

cert=/run/stellarr-turn/fullchain.pem
pkey=/run/stellarr-turn/privkey.pem
pidfile=/run/stellarr-turn/state/turnserver.pid
no-tlsv1
no-tlsv1_1

no-cli
stale-nonce=600
max-allocate-lifetime=300
# Loopback peers are disabled by default (allow-loopback-peers is unset).
# The entrypoint appends the local media IPs as the only exceptions.
no-tcp-relay
no-dynamic-ip-list
denied-peer-ip=0.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
no-multicast-peers
response-origin-only-with-rfc5780

log-file=stdout
simple-log
verbose
